# ============================================================
#  GetLeadSnow — environment template
#  Copy to `.env` on the SERVER and fill in real values.
#  NEVER commit the real .env (the .gitignore blocks it).
#  Variable names here match what the config/*.php files read.
# ============================================================

# --- App ---
APP_NAME="Lead Gen SaaS"
APP_URL=https://getleadsnow.allinonemarketing.com
APP_LOGO=/assets/logo.svg
ADMIN_EMAIL=admin@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com
FREE_SIGNUP_CREDITS=3

# --- Database ---
DB_HOST=localhost
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password

# --- RapidAPI (Google Maps data) + Replicate (enrichment) ---
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=maps-data.p.rapidapi.com
REPLICATE_API_KEY=your_replicate_key

# --- Stripe (billing) ---
# Confirm these names match exactly what your PHP reads; add any others you use
# (e.g. STRIPE_WEBHOOK_SECRET, STRIPE_PUBLISHABLE_KEY).
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_GROWTH=price_xxx
STRIPE_PRICE_ENTERPRISE=price_xxx

# --- Plan credits & prices (from subscription_config.php defaults) ---
PLAN_STARTER_CREDITS=5000
PLAN_GROWTH_CREDITS=15000
PLAN_ENTERPRISE_CREDITS=100000
PLAN_STARTER_PRICE=499
PLAN_GROWTH_PRICE=999
PLAN_ENTERPRISE_PRICE=2999
