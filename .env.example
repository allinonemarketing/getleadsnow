# =============================================================================
# Lead Gen SaaS - Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Or use install.php to set everything up automatically.
# =============================================================================

# --- App Branding -----------------------------------------------------------
APP_NAME="Lead Gen SaaS"
APP_URL="https://yourdomain.com"
APP_LOGO="/assets/logo.svg"
ADMIN_EMAIL="admin@yourdomain.com"
SUPPORT_EMAIL="support@yourdomain.com"

# --- Database ----------------------------------------------------------------
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# --- SMTP Email --------------------------------------------------------------
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=admin@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=admin@yourdomain.com
SMTP_FROM_NAME="Lead Gen SaaS"

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_PUBLIC_KEY=pk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_BILLING_PORTAL_URL=

# --- Stripe Price IDs (create these in your Stripe Dashboard) ----------------
STRIPE_PRICE_STARTER=price_xxxx
STRIPE_PRICE_GROWTH=price_xxxx
STRIPE_PRICE_ENTERPRISE=price_xxxx

# --- Plan Credits (monthly enrichment credits; lead search is free/unlimited) -
PLAN_STARTER_CREDITS=1000
PLAN_GROWTH_CREDITS=10000
PLAN_ENTERPRISE_CREDITS=100000

# --- Plan Prices (display only, in dollars) ----------------------------------
PLAN_STARTER_PRICE=499
PLAN_GROWTH_PRICE=999
PLAN_ENTERPRISE_PRICE=2999

# --- GoHighLevel provisioning webhook (ghl_webhook.php) ----------------------
# Shared secret GHL must send (header X-Webhook-Secret, ?key=, or body "secret").
# REQUIRED — the endpoint refuses all requests until this is set.
GHL_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Monthly credits granted to GHL-provisioned users (defaults to 1000 = Starter).
GHL_PLAN_CREDITS=1000

# --- Signups -> Google Sheet (optional) -------------------------------------
# Google Apps Script web-app URL. When set, each signup is appended to the sheet.
SIGNUP_SHEET_WEBHOOK=

# --- Meta (Facebook) Pixel + Conversions API --------------------------------
# Pixel fires a Lead client-side; the Conversions API sends the same event
# server-side (deduped via event_id). Override the baked-in defaults here.
FB_PIXEL_ID=
FB_CAPI_TOKEN=

# --- Signups -> GoHighLevel (owner's account) -------------------------------
# Private Integration token + sub-account (location) id. Override baked-in.
GHL_SIGNUP_TOKEN=
GHL_SIGNUP_LOCATION=

# --- Free Signup Credits -----------------------------------------------------
FREE_SIGNUP_CREDITS=3

# --- RapidAPI (for Google Maps search) -------------------------------------
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=maps-data.p.rapidapi.com

# --- Replicate (for website enrichment) --------------------------------------
REPLICATE_API_KEY=your_replicate_api_key_here

# --- OpenAI (optional) -------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
